# Data provider (current: yfinance only; other providers are future placeholders)
DATA_PROVIDER=yfinance

# Comma-separated tickers (used when UNIVERSE_PATH is unset)
TICKERS=7203.T,5333.T

# Optional global universe JSON (JP/US/EU mix). Prefer this for multi-market runs.
# UNIVERSE_PATH=config/universe.sample.json

# Lookback window in years
LOOKBACK_YEARS=10

# Bar interval (yfinance interval string)
INTERVAL=1d

# Raw CSV output directory (relative to project root)
RAW_DATA_DIR=data/raw

# Processed feature CSV output directory (relative to project root)
PROCESSED_DATA_DIR=data/processed

# Paper trading persistent state (portfolio / positions / history)
PAPER_STATE_DIR=data/paper

# Model / report output directories
MODELS_DIR=models
REPORTS_DIR=reports

# Chronological split ratios (must sum to 1.0)
TRAIN_RATIO=0.70
VALID_RATIO=0.15
TEST_RATIO=0.15

# Absolute-return threshold for target_5d_threshold (0.02 = ±2%)
TARGET_THRESHOLD=0.02

# Log directory and level
LOG_DIR=logs
LOG_LEVEL=INFO

# J-Quants (future)
# JQUANTS_API_KEY=
